# =============================================================================
# Frontend — paste into client/.env
# Supabase → Project Settings → API
# =============================================================================
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =============================================================================
# Backend — paste into server/.env
# Use the service role key. Do not expose it in the browser.
# =============================================================================
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
